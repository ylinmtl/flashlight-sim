             <layout class="QFormLayout" name="formLayout_Reflector">
              <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Diameter (mm)</string></property></widget></item>
              <item row="0" column="1"><widget class="QLineEdit" name="txtRef_diameter_mm"><property name="maximumSize"><size><width>100</width><height>16777215</height></size></property></widget></item>
              <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Height (mm)</string></property></widget></item>
