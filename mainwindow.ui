              <item row="6" column="1"><widget class="QComboBox" name="txtRef_surface_finish"><property name="toolTip"><string>Which reflectivity applies: the smooth figure or the orange peel one. Stored with the reflector like any other spec.</string></property><property name="maximumSize"><size><width>100</width><height>16777215</height></size></property></widget></item>
