    <!-- RIGHT SIDE: RESULTS VIEWER & EXECUTION -->
    <item>
     <widget class="QWidget" name="widgetResults" native="true">
      <property name="sizePolicy">
       <sizepolicy hsizetype="Preferred" vsizetype="Preferred">
        <horstretch>2</horstretch>
        <verstretch>0</verstretch>
       </sizepolicy>
      </property>
      <layout class="QVBoxLayout" name="verticalLayout_Results">
       <item>
        <widget class="QGroupBox" name="grpPlot">
         <property name="title"><string>Simulation Output</string></property>
         <layout class="QVBoxLayout" name="verticalLayout_PlotArea">
          <item>
           <widget class="QLabel" name="lblPlotPlaceholder">
            <property name="text"><string>The Matplotlib render will appear here.</string></property>
            <property name="alignment"><set>Qt::AlignCenter</set></property>
            <property name="sizePolicy">
             <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
              <horstretch>0</horstretch>
              <verstretch>0</verstretch>
             </sizepolicy>
            </property>
            <property name="frameShape"><enum>QFrame::Box</enum></property>
            <property name="minimumSize">
             <size>
              <width>600</width>
              <height>500</height>
             </size>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       
       <item>
        <widget class="QPlainTextEdit" name="txtLogs">
         <property name="readOnly"><bool>true</bool></property>
         <property name="maximumSize">
          <size>
           <width>16777215</width>
           <height>100</height>
          </size>
         </property>
         <property name="font">
          <font><family>Consolas</family></font>
         </property>
         <property name="placeholderText">
          <string>Simulation logs...</string>
         </property>
