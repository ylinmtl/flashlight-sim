              <item row="6" column="1"><widget class="QLineEdit" name="txtRef_reflectivity_op"/></item>
              <item row="7" column="0"><widget class="QLabel"><property name="text"><string>Reflectivity Cylinder</string></property></widget></item>
              <item row="7" column="1"><widget class="QLineEdit" name="txtRef_reflectivity_cylinder"/></item>
              <item row="8" column="0"><widget class="QLabel"><property name="text"><string>OP Factor Blur</string></property></widget></item>
              <item row="8" column="1"><widget class="QLineEdit" name="txtRef_OP_Factor"/></item>
             </layout>
            </widget>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="btnResetReflector">
            <property name="text"><string>Reset Reflector to Defaults</string></property>
           </widget>
          </item>
