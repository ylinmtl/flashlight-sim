       <!-- COLUMN 3: GASKET -->
       <item>
        <widget class="QGroupBox" name="grpGasket">
         <property name="title"><string>Gasket Library</string></property>
         <layout class="QVBoxLayout" name="verticalLayout_Gasket">
          <item>
           <widget class="QComboBox" name="cmbGasket"/>
          </item>
          <item>
           <widget class="QScrollArea" name="scrollGasket">
            <property name="widgetResizable"><bool>true</bool></property>
