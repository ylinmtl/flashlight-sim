  <property name="windowTitle">
   <string>Flashlight Beam FEA Simulator</string>
  </property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QHBoxLayout" name="horizontalLayout_Main">
    
    <!-- LEFT SIDE: HARDWARE CONTROLS (3 COLUMNS) -->
