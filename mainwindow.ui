              <item row="9" column="1"><widget class="QLineEdit" name="txtRef_reflectivity_cylinder"><property name="maximumSize"><size><width>100</width><height>16777215</height></size></property></widget></item>
              <item row="10" column="0"><widget class="QLabel"><property name="text"><string>Gasket Reflectivity</string></property></widget></item>
              <item row="10" column="1"><widget class="QLineEdit" name="txtRef_gasket_reflectivity"><property name="maximumSize"><size><width>100</width><height>16777215</height></size></property></widget></item>
              <item row="11" column="0"><widget class="QLabel"><property name="text"><string>OP Factor Blur</string></property></widget></item>
