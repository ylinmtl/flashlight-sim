      </property>
      <layout class="QHBoxLayout" name="horizontalLayout_Columns">
       
       <!-- COLUMN 1: REFLECTOR -->
       <item>
        <widget class="QGroupBox" name="grpReflector">
         <property name="title"><string>Reflector Library</string></property>
         <layout class="QVBoxLayout" name="verticalLayout_Reflector">
          <item>
           <widget class="QComboBox" name="cmbReflector"/>
          </item>
          <item>
           <widget class="QScrollArea" name="scrollReflector">
            <property name="widgetResizable"><bool>true</bool></property>
            <widget class="QWidget" name="scrollWidget_Reflector">
             <layout class="QFormLayout" name="formLayout_Reflector">
