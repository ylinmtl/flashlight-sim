              <item row="4" column="0"><widget class="QLabel"><property name="text"><string>Wall Thickness (mm)</string></property></widget></item>
              <item row="4" column="1"><widget class="QLineEdit" name="txtRef_wall_thickness_mm"><property name="toolTip"><string>Thickness of one reflector wall. Taken off the outer diameter twice, once per side, to give the reflective surface.</string></property><property name="maximumSize"><size><width>100</width><height>16777215</height></size></property></widget></item>
              <item row="5" column="0"><widget class="QLabel"><property name="text"><string>Base Thickness (mm)</string></property></widget></item>
